# Settings for one existing site. Copy to .env.<target> (git-ignored) for each site you test:
# .env.dev, .env.staging, .env.production, or .env.local for a throwaway site you run (Lando, a review app).
# npm run test:e2e:<target> loads only that file. Playground needs none.
#
# Credentials are plain text for now; they'll move to 1Password references (op run) later.

BASE_URL=https://dev.example.com

# Glomar access gate: query string that grants the access cookie. Leave empty if the site has no gate.
GLOMAR_QUERY=secret=1

# Local sites only: accept a self-signed HTTPS certificate (Lando, Local). Refused for any other target.
# IGNORE_HTTPS_ERRORS=1

# Optional HTTP basic auth, if the site is password-protected.
HTTP_USERNAME=
HTTP_PASSWORD=

# Optional: override the ModernPress breakpoints (px, "this width and narrower") for a client site.
# BREAKPOINT_COLUMNS_STACK=781
# BREAKPOINT_MOBILE_NAV=959

# Roles to log in as (comma-separated WordPress role slugs). Ignored on production.
QA_ROLES=administrator,editor

# One USER/PASSWORD pair per role: QA_<ROLE>_USER and QA_<ROLE>_PASSWORD.
# A role with no credentials has its tests skipped, not failed.
QA_ADMINISTRATOR_USER=
QA_ADMINISTRATOR_PASSWORD=
QA_EDITOR_USER=
QA_EDITOR_PASSWORD=

# Automation account for the REST API. Quote the application password: it contains spaces.
QA_AUTOMATION_USER=
QA_AUTOMATION_APP_PASSWORD=""
