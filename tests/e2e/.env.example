# Copy to .env (git-ignored) and fill in. Only needed for live environments; Playground needs nothing here.

# Which site to run against: playground (default) | dev | staging | production.
# The npm run test:e2e:<env> scripts set this for you.
# TEST_ENV=dev

DEV_BASE_URL=https://dev.example.com
STAGING_BASE_URL=https://staging.example.com
PRODUCTION_BASE_URL=https://www.example.com

# Optional: override the ModernPress breakpoints (px, "this width and narrower") for a client site.
# BREAKPOINT_COLUMNS_STACK=781
# BREAKPOINT_MOBILE_NAV=959

# Optional HTTP basic auth, if the environment is password-protected.
HTTP_USERNAME=
HTTP_PASSWORD=

# Glomar access gate: query string that grants the access cookie. Leave empty if the environment has no gate.
DEV_GLOMAR_QUERY=secret=1
STAGING_GLOMAR_QUERY=
PRODUCTION_GLOMAR_QUERY=

# Roles to log in as (comma-separated WordPress role slugs). Ignored on production.
QA_ROLES=administrator,editor

# One USER/PASSWORD pair per role: QA_<ROLE>_USER and QA_<ROLE>_PASSWORD.
# A role with no credentials has its tests skipped, not failed.
QA_ADMINISTRATOR_USER=
QA_ADMINISTRATOR_PASSWORD=
QA_EDITOR_USER=
QA_EDITOR_PASSWORD=

# Automation account for the REST API. Quote the application password: it contains spaces.
QA_AUTOMATION_USER=
QA_AUTOMATION_APP_PASSWORD=""
